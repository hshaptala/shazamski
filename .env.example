# Shazamski local config — copy to `.env` and fill in (no `export` needed).
# CLI flags override these when passed explicitly.
#
# Public SoundCloud widget key (not a secret, but keep local): Chrome DevTools →
# Network tab → play any soundcloud.com track → copy `client_id` from a request URL.
SOUNDCLOUD_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channel to index (full profile URL + slug for convenience).
SHAZAMSKI_CHANNEL=https://soundcloud.com/YOUR-CHANNEL
SHAZAMSKI_ARTIST=YOUR-CHANNEL
# Output index file.
SHAZAMSKI_OUT=shazamski-index.json
# Seconds fingerprinted per track head (30–120).
SHAZAMSKI_SECONDS=120
# Parallel ffmpeg+fpcalc jobs (2–4 to avoid rate limits; benchmark on your machine).
SHAZAMSKI_CONCURRENCY=3
# Uncomment for smoke tests only — limits to first N tracks. Keep commented for full runs.
# SHAZAMSKI_LIMIT=20
# Uncomment for list-only mode (no audio work).
# SHAZAMSKI_DRY_RUN=0
# Set to 1 to disable resume (re-do tracks already in OUT). Default: resume on.
SHAZAMSKI_NO_RESUME=0
# Binary paths (defaults: PATH lookup).
SHAZAMSKI_FFMPEG=ffmpeg
SHAZAMSKI_FPCALC=fpcalc
